<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Calls the game's database layer (Bussiness) without the game. Built twice by run.sh: against this tree's
    Bussiness (MariaDB) and against the SQL Server version's (BussinessProject=<that tree>/Bussiness/Bussiness.csproj),
    so the two runs can be compared.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BussinessProject Condition="'$(BussinessProject)' == ''">../../Bussiness/Bussiness.csproj</BussinessProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(BussinessProject)" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="log4net" Version="3.6.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>
</Project>
