<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Merged from Tank.Request/Web.config and Tank.Flash/Web.config (appSettings only; both sites now run in one process,
	     so LoginKey is shared - the two Web.config files had different values). Connection strings come from
	     appSettings.local.config, generated by deploy/configure-local.sh. -->
	<appSettings file="appSettings.local.config">
		<!-- Tank.Web host -->
		<add key="Web.Urls" value="http://127.0.0.1:8080" />
		<add key="Web.PublicBaseUrl" value="http://127.0.0.1:8080" />
		<add key="Web.RequestRoot" value="../../../../Tank.Request" />
		<add key="Web.SiteRoot" value="../../../../Tank.Flash" />
		<add key="Web.FlashRoot" value="../../../../Source Flash/FlashSV1" />
		<add key="Web.ResourceRoot" value="../../../../resource" />
		<!-- optional: fetch /resource/ files missing locally from this site (streamed, not stored); set in appSettings.local.config -->
		<add key="Web.ResourceUpstream" value="" />
		<!-- where files fetched from Web.ResourceUpstream are saved and served from next time; empty value = do not cache -->
		<add key="Web.ResourceCacheRoot" value="../../../../resource-cache" />
		<add key="Web.Ruffle" value="true" />
		<add key="Web.RuffleUrl" value="https://unpkg.com/@ruffle-rs/ruffle@0.7.1/ruffle.js" />
		<!-- game socket via WebSocket for Ruffle: SocketHost must match Server_List.IP -->
		<add key="Web.SocketHost" value="127.0.0.1" />
		<add key="Web.SocketTarget" value="127.0.0.1" />
		<add key="Web.SocketPorts" value="9500" />
		<add key="CenterServiceAddress" value="net.tcp://127.0.0.1:2009/" />
		<!-- legacy settings -->
		<add key="ServerID" value="4" />
		<add key="ReqPath" value="" />
		<add key="LanguagePath" value="bin/Languages/Language-vn.txt" />
		<add key="IllegalDirectory" value="./Illegalcharacters" />
