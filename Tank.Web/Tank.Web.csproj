<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Linux/.NET 8 host for the legacy web sites:
      /          Tank.Flash   (login page, game page)
      /Request/  Tank.Request (the HTTP API the Flash client calls)
      /flash/    the Flash client (Source Flash/FlashSV1)
      /resource/ the game resource pack (not in this repo)
    The original IHttpHandler (.ashx) code is compiled unchanged on top of
    Microsoft.AspNetCore.SystemWebAdapters. The few .aspx pages needed for
    login are ported in LegacyPages/.
  -->
  <PropertyGroup>
    <AssemblyName>Tank.Web</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0168;CS0219;CS0414;CS0649;CS0169;CS0162;CS0108;CS0114;CS1998;SYSLIB0011;SYSLIB0014;SYSLIB0021;SYSLIB0023;CA1416</NoWarn>
  </PropertyGroup>
