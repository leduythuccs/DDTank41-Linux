<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings file="appSettings.local.config">
		<add key="LanguagePath" value="Languages/Language-vn.txt" />
		<add key="SystemNoticePath" value="Languages/SystemNotice.xml" />
		<add key="conString" value="Data Source=KHANHDUY\SQLEXPRESS;Initial Catalog=Project_Player34;Persist Security Info=True;User ID=sa;Password=abc@123" />
		<add key="crosszoneString" value="Data Source=KHANHDUY\SQLEXPRESS;Initial Catalog=Project_Game34;Persist Security Info=True;User ID=sa;Password=abc@123" />
		<add key="IP" value="127.0.0.1" />
		<add key="Port" value="9202" />
		<add key="LoginLapseInterval" value="1" />
		<add key="SaveInterval" value="1" />
		<add key="SaveRecordInterval" value="1" />
		<add key="ScanAuctionInterval" value="60" />
		<add key="ScanMailInterval" value="120" />
		<add key="ScanConsortiaInterval" value="1" />
		<add key="ServerID" value="4" />
		<add key="GameType" value="1" />
		<add key="AreaID" value="1001" />
		<add key="LogPath" value="RecordLog" />
		<add key="TxtRecord" value="true" />
		<add key="HelpStr" value="退出:exit;重新加载:reload;系统公告:notice;ssssssss" />
		<!--anti-addiction system-->
		<add key="AAS" value="false" />
		<!--Daily-Award-Open-->
		<add key="DailyAwardState" value="true" />
		<add key="ClientSettingsProvider.ServiceUri" value="" />
		<!-- CoreWCF host for Center.Server.ICenterService (replaces <system.serviceModel>). Admin API without auth: keep it on loopback or a private network. -->
		<add key="CenterServiceHost" value="127.0.0.1" />
		<add key="CenterServiceTcpPort" value="2009" />
		<add key="CenterServiceHttpPort" value="2008" />
	</appSettings>
</configuration>