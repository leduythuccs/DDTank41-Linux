<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Center.Service</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <StartupObject>Center.Service.Program</StartupObject>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>alpha.ico</ApplicationIcon>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0168;CS0219;CS0414;CS0649;CS0169;CS0162;CS0108;CS0114;SYSLIB0011;SYSLIB0014;SYSLIB0021;SYSLIB0023;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.6.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bussiness\Bussiness.csproj" />
    <ProjectReference Include="..\Center.Server\Center.Server.csproj" />
    <ProjectReference Include="..\Game.Base\Game.Base.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="logconfig.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- local overrides (connection strings), generated by deploy/configure-local.sh -->
    <None Include="appSettings.local.config" Condition="Exists('appSettings.local.config')" CopyToOutputDirectory="PreserveNewest" />
    <!-- runtime data -->
    <None Update="Languages\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="macrodrop\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
