<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Road.Service</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <StartupObject>Game.Service.Program</StartupObject>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>alpha.ico</ApplicationIcon>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0168;CS0219;CS0414;CS0649;CS0169;CS0162;CS0108;CS0114;SYSLIB0011;SYSLIB0014;SYSLIB0021;SYSLIB0023;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.6.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows service install/control (System.ServiceProcess / System.Configuration.Install).
         On Linux run Road.Service (console mode) under systemd instead. -->
    <Compile Remove="GameServerService.cs;GameServerServiceInstaller.cs;Actions\ServiceInstall.cs;Actions\ServiceUninstall.cs;Actions\ServiceRun.cs;Actions\ServiceStart.cs;Actions\ServiceStop.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bussiness\Bussiness.csproj" />
    <ProjectReference Include="..\Game.Base\Game.Base.csproj" />
    <ProjectReference Include="..\Game.Logic\Game.Logic.csproj" />
    <ProjectReference Include="..\Game.Server\Game.Server.csproj" />
    <ProjectReference Include="..\SqlDataProvider\SqlDataProvider.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="logconfig.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- local overrides (connection strings), generated by deploy/configure-local.sh -->
    <None Include="appSettings.local.config" Condition="Exists('appSettings.local.config')" CopyToOutputDirectory="PreserveNewest" />
    <None Update="battle.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Datas\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- runtime data: this service's language file, and the maps and bombs shared with the other server -->
    <None Update="Languages\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\GameData\map\**" Link="map\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\GameData\bomb\**" Link="bomb\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
