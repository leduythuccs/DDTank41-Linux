<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Linux/.NET 8 host for the GameAdmin site (AdminGunny, an ASP.NET WebForms app): send mail with
    items, Xu, Vàng and Lễ kim to characters. The original pages in ../GameAdmin are rendered as they
    are (WebFormsLite.cs fills in their few server controls); the code-behind and the
    mainRequest.ashx page methods are ported in ItemPages.cs and AdminMethods.cs.
    Listens on 127.0.0.1 only and asks for the password set in appSettings.local.config.
  -->
  <PropertyGroup>
    <AssemblyName>GameAdmin.Web</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0618;SYSLIB0014;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bussiness\Bussiness.csproj" />
    <ProjectReference Include="..\SqlDataProvider\SqlDataProvider.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Tank.Web\CaseInsensitiveFileProvider.cs" Link="CaseInsensitiveFileProvider.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="logconfig.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- local overrides (connection strings, admin password), generated by deploy/configure-local.sh -->
    <None Include="appSettings.local.config" Condition="Exists('appSettings.local.config')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
