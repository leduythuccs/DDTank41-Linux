<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- From GameAdmin/Web.config. Connection strings and Admin.Password come from appSettings.local.config,
	     generated by deploy/configure-local.sh. -->
	<appSettings file="appSettings.local.config">
		<!-- GameAdmin.Web host -->
		<add key="Admin.Urls" value="http://127.0.0.1:8081" />
		<!-- the original site (pages, scripts, images), relative to the binary -->
		<add key="Admin.Root" value="../../../../GameAdmin" />
		<!-- login password; empty = the site refuses every login -->
		<add key="Admin.Password" value="" />
		<add key="CenterServiceAddress" value="net.tcp://127.0.0.1:2009/" />
		<!-- item icons: the Tank.Web resource folder (and its CDN cache) -->
		<add key="Resource" value="http://127.0.0.1:8080/resource/" />
		<add key="LanguagePath" value="../../../../Tank.Request/bin/Languages/Language-vn.txt" />
		<!-- legacy settings -->
		<add key="ServerID" value="1001" />
		<add key="MAX_COMPOSE" value="50" />
		<add key="MAX_STRENGTGTHEN" value="15" />
		<add key="conString" value="set in appSettings.local.config (deploy/configure-local.sh)" />
		<add key="crosszoneString" value="set in appSettings.local.config (deploy/configure-local.sh)" />
	</appSettings>
</configuration>
